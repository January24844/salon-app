# Skopiuj ten plik jako .env.local i uzupełnij wartości.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Klucz serwisowy – TYLKO na serwerze (wysyłka SMS/maili), nigdy w przeglądarce
SUPABASE_SERVICE_ROLE_KEY=

# Adres aplikacji (lokalnie / po wdrożeniu)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Etap 2: wiadomości (można zostawić puste) ---
# SMSAPI.pl → Panel → Tokeny API
SMSAPI_TOKEN=
SMSAPI_SENDER=
# Resend.com → API Keys
RESEND_API_KEY=
EMAIL_FROM="Mój Salon <wizyty@twojadomena.pl>"
# Dowolny długi losowy ciąg – zabezpiecza automat wysyłki
CRON_SECRET=
